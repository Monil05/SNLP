{
  "$defs": {
    "CategoryScore": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Probability",
          "type": "number"
        }
      },
      "required": [
        "category",
        "probability"
      ],
      "title": "CategoryScore",
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "description": "Confidence attached to a result.\n\n``score`` is in [0, 1]. For classification it is the model's predicted\nprobability. For matching/recommendation it is an *evidence-sufficiency*\nheuristic (how much signal the result rests on) - it is NOT a calibrated\nprobability that the answer is correct. ``calibrated`` says which it is.",
      "properties": {
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "level": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Level",
          "type": "string"
        },
        "method": {
          "default": "evidence_heuristic_v1",
          "title": "Method",
          "type": "string"
        },
        "calibrated": {
          "default": false,
          "title": "Calibrated",
          "type": "boolean"
        },
        "factors": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-factor breakdown. Only populated when include_details=true.",
          "title": "Factors"
        }
      },
      "required": [
        "score",
        "level"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "asset_version": {
          "default": "1.0.0",
          "title": "Asset Version",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelInfo"
        },
        "processing_ms": {
          "title": "Processing Ms",
          "type": "number"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "model",
        "processing_ms"
      ],
      "title": "Meta",
      "type": "object"
    },
    "ModelInfo": {
      "additionalProperties": false,
      "properties": {
        "embedding_backend": {
          "title": "Embedding Backend",
          "type": "string"
        },
        "embedding_model": {
          "title": "Embedding Model",
          "type": "string"
        },
        "jobs_indexed": {
          "title": "Jobs Indexed",
          "type": "integer"
        }
      },
      "required": [
        "embedding_backend",
        "embedding_model",
        "jobs_indexed"
      ],
      "title": "ModelInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "predicted_category": {
      "title": "Predicted Category",
      "type": "string"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "top_categories": {
      "items": {
        "$ref": "#/$defs/CategoryScore"
      },
      "title": "Top Categories",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    }
  },
  "required": [
    "predicted_category",
    "confidence",
    "top_categories",
    "meta"
  ],
  "title": "ClassifyResponse",
  "type": "object"
}