{
  "$defs": {
    "JobDescriptionInput": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "job_title": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Title"
        },
        "job_text": {
          "description": "Full text of one job description.",
          "minLength": 1,
          "title": "Job Text",
          "type": "string"
        }
      },
      "required": [
        "job_text"
      ],
      "title": "JobDescriptionInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "student_text": {
      "minLength": 1,
      "title": "Student Text",
      "type": "string"
    },
    "job_descriptions": {
      "items": {
        "$ref": "#/$defs/JobDescriptionInput"
      },
      "maxItems": 20,
      "minItems": 2,
      "title": "Job Descriptions",
      "type": "array"
    },
    "include_details": {
      "default": false,
      "title": "Include Details",
      "type": "boolean"
    }
  },
  "required": [
    "student_text",
    "job_descriptions"
  ],
  "title": "CompareJobsRequest",
  "type": "object"
}